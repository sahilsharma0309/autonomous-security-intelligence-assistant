# =============================================================================
#  Autonomous Security & Intelligence Assistant — configuration
# =============================================================================
#  Copy to `.env` and fill in what you need. Nothing here is required to run
#  the core engine or the test suite; every key below enables one optional
#  capability, and each module degrades honestly when its key is absent
#  (reporting "not checked" rather than "clean").
#
#  `.env` is gitignored. Never commit real values.
# =============================================================================


# -----------------------------------------------------------------------------
#  Runtime
# -----------------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  Engagement authorization  (Module 1)
# -----------------------------------------------------------------------------
#  The scope is the safety boundary for the whole system. An empty scope
#  authorizes NOTHING — every target is denied. That is deliberate: forgetting
#  to set a scope must be a refusal, not an unbounded scan.
#
#  Hosts, domains (with `*.` wildcards) and CIDRs, comma-separated.
ENGAGEMENT_ALLOW=
#  Targets refused even if an allow rule also matches. Denies always win.
ENGAGEMENT_DENY=
#  passive   — never contacts the target (WHOIS, threat-intel lookups)
#  active    — contacts it non-intrusively (DNS, TCP connect, HTTP GET)
#  intrusive — may change state or trip alerting (control-port probes)
ENGAGEMENT_MAX_RISK=active
#  Your authorization record: ticket, SOW, or engagement ID. Written to the
#  audit trail on every scope-gated call.
ENGAGEMENT_AUTHORIZATION_REF=


# -----------------------------------------------------------------------------
#  Module 3 — IoT & asset discovery
# -----------------------------------------------------------------------------
#  https://account.shodan.io/  — without it, iot.shodan_* fail loudly rather
#  than returning an empty result that reads as "nothing exposed".
SHODAN_API_KEY=


# -----------------------------------------------------------------------------
#  Module 4 — Threat intelligence
# -----------------------------------------------------------------------------
#  https://www.virustotal.com/gui/my-apikey
#  The public tier allows 4 requests/minute; the client rate-limits itself to
#  match, so a burst is smoothed rather than rejected.
VIRUSTOTAL_API_KEY=

#  https://urlscan.io/user/apikey
#  NOTE: `threat.urlscan_submit` causes urlscan.io to FETCH the target, so the
#  target's logs record a visit. It is classified ACTIVE for that reason, and
#  submissions default to `unlisted` so a lookup does not publish what you are
#  investigating.
URLSCAN_API_KEY=

#  Docker network the URL sandbox joins. Create it before scanning:
#      docker network create sandbox-egress
#  It should permit egress to the public internet and have NO route to this
#  host or to internal ranges — that boundary is what actually contains a
#  hostile page. Without a container runtime the sandbox FAILS CLOSED; pass
#  --allow-static-fallback to accept script-free HTTP inspection instead.
SANDBOX_NETWORK=sandbox-egress
SANDBOX_IMAGE=mcr.microsoft.com/playwright/python:v1.47.0-jammy


# -----------------------------------------------------------------------------
#  Module 5 — VPN, kill-switch, daemon
# -----------------------------------------------------------------------------
VPN_INTERFACE=wg0
#  wireguard | openvpn
VPN_BACKEND=wireguard

#  Recover a dropped tunnel automatically. Bounded by a state machine: five
#  attempts with exponential backoff, then NEEDS_OPERATOR (terminal until an
#  operator resets it). Disable at runtime with --no-auto-reconnect.
VPN_AUTO_RECONNECT=true

#  Block non-VPN traffic when the tunnel is unusable. OFF by default: it
#  rewrites the host firewall and needs a deliberate decision.
VPN_KILLSWITCH_ENABLED=false

#  !! READ THIS IF THE HOST IS REMOTE !!
#  Networks the kill-switch must never block — typically the range you SSH
#  from. The lockout guard always preserves loopback, established connections
#  and the VPN endpoint, but it cannot know your admin range unless you say.
#  Getting this wrong on a remote host locks you out permanently.
VPN_ADMIN_CIDRS=

#  Nothing executes system commands unless this is true (CLI: --execute).
#  The default runner records intent and changes nothing.
ALLOW_SYSTEM_EXECUTION=false


# -----------------------------------------------------------------------------
#  Module 6 — Web dashboard
# -----------------------------------------------------------------------------
#  REQUIRED to start the dashboard. The console dispatches agent runs and can
#  change VPN and firewall state, so it refuses to run unauthenticated and
#  will not invent a key for you. Minimum 32 characters. Generate one:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8443
#  Binding off-loopback exposes an agent-control surface. Combining a
#  non-loopback bind with --execute is refused outright. Prefer an SSH tunnel:
#      ssh -L 8443:127.0.0.1:8443 user@host
DASHBOARD_SESSION_TTL_SECONDS=43200


# -----------------------------------------------------------------------------
#  Optional integrations
# -----------------------------------------------------------------------------
#  Neo4j, for persisting the entity graph beyond a single run. The exporter
#  emits parameterized MERGE statements; entity values never reach query text.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

#  Vector memory backend for the agent's long-term recall.
VECTOR_DB_PATH=./.state/memory
