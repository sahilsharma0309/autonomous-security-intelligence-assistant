# Copy to .env and fill in real values. Never commit .env.
#
# The agent core needs none of these to run -- they configure the optional
# feature modules and their third-party integrations.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Engagement authorization
#
# This is the safety boundary, not a convenience setting. The agent refuses to
# contact any host that ENGAGEMENT_ALLOW does not cover, and refuses any action
# more intrusive than ENGAGEMENT_MAX_RISK. An empty allow list authorizes
# nothing, which is the intended default.
#
# ENGAGEMENT_MAX_RISK:
#   passive   - never contacts the target (public datasets, threat-intel APIs)
#   active    - contacts the target non-intrusively (DNS, TCP connect, HTTP GET)
#   intrusive - may change target state or trip alerting; opt in deliberately
#
# Record the written authorization (contract, ticket, scope document) in
# ENGAGEMENT_AUTHORIZATION_REF -- it is written into every audit record.
# ---------------------------------------------------------------------------
ENGAGEMENT_NAME=
ENGAGEMENT_AUTHORIZATION_REF=
ENGAGEMENT_ALLOW=
ENGAGEMENT_DENY=
ENGAGEMENT_MAX_RISK=passive
ENGAGEMENT_EXPIRES_AT=
ENGAGEMENT_ALLOW_PRIVATE_RANGES=true

# --- Module 2: OSINT & Entity Graph ---
OSINT_RATE_LIMIT_PER_MIN=30
# Optional Neo4j backend; NetworkX is used in-process when unset.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Module 3: IoT & Asset Discovery ---
SHODAN_API_KEY=
IOT_SCAN_TIMEOUT_SECONDS=30
IOT_MAX_CONCURRENT_HOSTS=50

# --- Module 4: Threat Intelligence & URL Deep Scanner ---
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
THREAT_INTEL_FEED_URL=

# --- Module 5: Network / VPN daemon ---
VPN_PROVIDER=
VPN_CONFIG_PATH=
VPN_KILL_SWITCH=true

# --- Long-term memory ---
# Leave VECTOR_DB_URL unset to use the built-in in-process vector store.
VECTOR_DB_URL=
EMBEDDING_MODEL=

# --- LLM-backed planning (optional) ---
ANTHROPIC_API_KEY=

# --- Storage & notifications ---
DATABASE_URL=sqlite:///./data/assistant.db
ALERT_WEBHOOK_URL=
